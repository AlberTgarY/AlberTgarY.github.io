<ul class="card-text font-weight-light list-group list-group-flush">
  {% for content in data[1] %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ content.year }} </span>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            <a href="{{ content.url }}" target="_blank" rel="noopener noreferrer">{{ content.name }}</a
            ><span class="mentee-role">, {{ content.role }}</span>
          </h6>
          <h6 class="mentee-next ml-1 ml-md-4"><i class="fa-solid fa-arrow-right iconlocation"></i> <span>Next:</span> {{ content.next }}</h6>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
